# Google OAuth client IDs (public, not secrets) used by src/services/googleAuth.ts.
# Create these in Google Cloud Console as Android / iOS client types (NOT "Web application" —
# Google rejects custom-scheme redirect URIs for Web clients).
# Copy this file to .env.local and fill in the real values.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
